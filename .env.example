# Copie para .env e preencha. O .env fica fora do Git.

# Chave da API do Gemini (Google AI Studio)
GOOGLE_API_KEY=

# Modelo que gera as respostas e extrai os filtros da pergunta
GEMINI_CHAT_MODEL=

# Modelo que julga relevancia e fidelidade na avaliacao (diferente do gerador)
GEMINI_JUDGE_MODEL=

# Modelo de reserva quando o principal falha (opcional)
GEMINI_FALLBACK_MODEL=

# 1 roda a avaliacao num subconjunto de perguntas, para iterar sem gastar a cota
TC_RAPIDO=0

# Arquivo com as variaveis acima fora do repositorio (opcional; o .env local tambem vale)
TC_ENV_FILE=

# Segundos minimos entre chamadas ao mesmo modelo e chamadas simultaneas
TC_LLM_INTERVALO=4
TC_LLM_PARALELO=1
